# === Deuce Market 환경 변수 예시 ===
# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.
#   cp .env.example .env
#
# SECRET_KEY: 세션/CSRF 서명에 사용됩니다. 반드시 예측 불가능한 랜덤 값으로 설정하세요.
#   생성 예:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Flask 실행 환경 (development / production)
FLASK_ENV=development

# 운영 환경에서 HTTPS를 쓸 경우 True 로 설정 (세션 쿠키를 HTTPS 전용으로 강제)
SESSION_COOKIE_SECURE=False
